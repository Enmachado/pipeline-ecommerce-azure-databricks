    "# Célula 1 — Configuração de acesso\n",
    "spark.conf.set(\"SUA_CHAVE_AQUI\")\n",
    "\n",
    "# Célula 2 — Leitura do CSV\n",
    "df = spark.read.format(\"csv\") \\\n",
    "    .option(\"header\", \"true\") \\\n",
    "    .option(\"inferSchema\", \"true\") \\\n",
    "    .load(\"SUA_CHAVE_AQUI/vendas/vendas_ecommerce.csv\")\n",
    "\n",
    "display(df)"
   ]
